# CUDA 12 userspace comes from the exact NVIDIA/JAX wheel pins in requirements.txt.
# Modal supplies the NVIDIA driver; no host GPU or credentials are used during build.
FROM python@sha256:0f086103b026048cc50cb5da25ec435c023c5241a83fc44daea593377abc61c4
RUN apt-get update && apt-get install -y --no-install-recommends libegl1 libgl1 libglfw3 libgomp1 && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/sx/.venv
ENV PATH="/opt/sx/.venv/bin:$PATH" PYTHONPATH="/opt/xmimic" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MUJOCO_GL=egl
WORKDIR /opt/xmimic
COPY data/runtime-images/ /opt/runtime-wheels/
COPY xmimic/ xmimic/
COPY requirements.txt Dockerfile.cpu Dockerfile.gpu .dockerignore ./
COPY tools/build_runtime_wheels.py tools/build_runtime_wheels.py
RUN python tools/build_runtime_wheels.py --verify --output /opt/runtime-wheels
RUN python -m pip install --require-hashes --only-binary=:all: -r /opt/runtime-wheels/gpu.lock
RUN python -m pip check && python -c 'import sx_training,sx_embodiments,sx_geometry,jax,mujoco,warp; from xmimic.managed_worker import train'
CMD ["/opt/sx/.venv/bin/python", "-m", "sx_training", "--help"]
